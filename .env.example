# 运行环境 development / test / production
NODE_ENV=development

# 数据库（MySQL 8.0+）
# 说明：Prisma 不支持在 MySQL 上使用 String[] 标量列表，故商品图片 / 评价晒图字段用 Json 存字符串数组
DATABASE_URL="mysql://root:你的密码@localhost:3306/smart_second_hand"

# JWT
JWT_SECRET="your-super-secret-key-change-me"
JWT_EXPIRES_IN="7d"

# 登录 / 注册限流：15 分钟窗口内允许的失败次数（成功请求不计入）
AUTH_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=30

# 允许跨域的前端地址，多个用英文逗号分隔。
# Vercel 的预览域名（<project>-<hash>-<scope>.vercel.app）由代码里的正则自动放行，
# 无需在这里逐个写。
CORS_ORIGIN="http://localhost:5173,https://smart-second-hand.vercel.app"

# ---------- 图片存储（二选一） ----------
# 配齐下面三项 → 上传走 Cloudinary（适合 Railway / Vercel 这类临时文件系统）
# 三项缺任意一项 → 自动退回本地磁盘 server/uploads（本地开发、断网演示、E2E 都不受影响）
# Cloudinary 控制台 → Dashboard 可以看到 cloud name / API Key / API Secret
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="123456789012345"
# CLOUDINARY_API_SECRET="your-api-secret"
# 云端目录前缀（在 Cloudinary Media Library 里按项目归类）
# CLOUDINARY_FOLDER="smart-second-hand"
# 本地驱动下的上传目录（默认 <cwd>/uploads，容器部署时建议挂持久卷）
# UPLOAD_DIR="/var/www/smart-second-hand-platform/server/uploads"

# AI API（Key 仅后端使用，前端永远拿不到）
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_API_URL="https://api.deepseek.com/v1/chat/completions"
DEEPSEEK_MODEL="deepseek-chat"
# 单次调用超时（毫秒），超时自动降级为关键词搜索
AI_TIMEOUT_MS=5000
# AI 助手流式回答的整体超时 / 首字超时（毫秒）
AI_CHAT_TIMEOUT_MS=30000
AI_FIRST_TOKEN_TIMEOUT_MS=6000
# 设为 true 时完全走本地规则解析，不联网、不消耗 API 额度（断网演示用）
AI_MOCK=false

# 服务端口
PORT=3000