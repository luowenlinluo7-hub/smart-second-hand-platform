# 运行环境 development / test / production
NODE_ENV=development

# 数据库（PostgreSQL；Supabase 直接复制控制台的连接串，末尾需带 ?schema=public）
# 说明：Prisma 不支持在 MySQL 上使用 String[]（商品图片字段），故本项目使用 PostgreSQL
DATABASE_URL="postgresql://postgres:你的密码@localhost:5432/smart_second_hand?schema=public"

# JWT
JWT_SECRET="your-super-secret-key-change-me"
JWT_EXPIRES_IN="7d"

# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGIN="http://localhost:5173"

# AI API
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_API_URL="https://api.deepseek.com/v1/chat/completions"

# 服务端口
PORT=3000